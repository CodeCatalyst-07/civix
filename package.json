{
  "name": "civix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ai:smoke": "node --conditions=react-server --import tsx scripts/ai-runner.ts smoke",
    "ai:experiments": "node --conditions=react-server --import tsx scripts/ai-runner.ts experiments",
    "ai:compare-thinking": "node --conditions=react-server --import tsx scripts/ai-compare-thinking.ts",
    "ai:analyze-synthetic": "node --conditions=react-server --import tsx scripts/ai-analyze-synthetic.ts",
    "documents:verify": "node --conditions=react-server --import tsx scripts/documents/verify.ts",
    "documents:fixtures": "node --import tsx scripts/documents/generate-fixtures.ts"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "next": "^16.4.2",
    "pdfjs-dist": "https://registry.npmjs.org/pdfjs-dist/-/pdfjs-dist-6.3.289.tgz",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
