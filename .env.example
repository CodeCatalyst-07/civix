# Optional until real inference. Set locally, never paste keys into chat.
GEMINI_API_KEY=
# Optional stored backup; current provider uses GEMINI_API_KEY only.
# Automatic credential failover is not enabled.
GEMINI_API_KEY_BACKUP=
# No automatic model fallback. Secondary: gemma-4-31b-it
AI_MODEL=gemma-4-26b-a4b-it
AI_REQUEST_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_MAX_CONCURRENT_REQUESTS=1
CIVIX_MOCK_ANALYSIS=true
# Next.js sets NODE_ENV automatically; normally leave it unset.
# NODE_ENV=development
